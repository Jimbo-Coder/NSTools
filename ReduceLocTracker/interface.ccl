# Interface definition for thorn ReduceLocTracker

implements: ReduceLocTracker
inherits: Grid

CCTK_POINTER_TO_CONST FUNCTION GetMPICommWorld (CCTK_POINTER_TO_CONST IN cctkGH)
USES FUNCTION GetMPICommWorld

# Code shared with NSSurface.
INCLUDES HEADER: NSTools.hxx in NSTools.hxx

public:

CCTK_REAL reduce_loc_reals[16] TYPE=SCALAR tags='checkpoint="yes"'
{
  reduce_loc_value
  reduce_loc_comparison_value
  reduce_loc_x
  reduce_loc_y
  reduce_loc_z
  reduce_loc_radius
  reduce_loc_count
} "Last valid extrema, coordinates, and radii, with latest search tie counts"
