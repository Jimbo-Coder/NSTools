# Parameter definitions for thorn ReduceLocTracker

private:

CCTK_STRING tracked_var[16] "Grid function whose extremum this slot follows (none set anywhere: slots 0-2 follow density maxima of HydroBase::rho)"
{
  ".*" :: "empty string disables this slot"
} ""

KEYWORD reduction[16] "Extremum operation for each tracked variable"
{
  "maximum"     :: "track the maximum value"
  "minimum"     :: "track the minimum value"
  "maximum_abs" :: "track the maximum absolute value"
  "minimum_abs" :: "track the minimum absolute value"
} "maximum"

CCTK_REAL target_x0[16] "Initial x-coordinate of the extremum (target_x0/y0/z0 all 0: placed by the tracker)"
{
  *:* :: "unrestricted"
} 0.0

CCTK_REAL target_y0[16] "Initial y-coordinate of the extremum"
{
  *:* :: "unrestricted"
} 0.0

CCTK_REAL target_z0[16] "Initial z-coordinate of the extremum"
{
  *:* :: "unrestricted"
} 0.0

CCTK_REAL target_radius[16] "Search radius about the previous location"
{
  0    :: "no limit beyond the points nearest this slot"
  (0:* :: "coordinate radius"
} 0.0

CCTK_INT compute_every "How often to update the tracked extrema"
{
   1:* :: "update every so many iterations"
  -1:0 :: "disable updates"
  -2   :: "the 0D/scalar output cadence (else IO::out_every)"
} -2

CCTK_REAL min_prominence "Two extrema of one variable and reduction are separate when the value dips between them by at least this fraction of the stronger one's magnitude"
{
  (0:1] :: "fraction of the stronger extremum's magnitude"
} 0.05
